{
  "name": "@draco/security",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draco Security — enterprise security layer with SAST, DAST, secrets detection, dependency auditing, container scanning, and threat modeling",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings --vcs-enabled=false src",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "@biomejs/biome": "2.5.12"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
